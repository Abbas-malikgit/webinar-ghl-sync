# ─── Server ─────────────────────────────────────────
PORT=3000

# ─── Dashboard Auth (HTTP Basic) ────────────────────
# Leave blank to run in open/dev mode (not recommended for production)
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me-to-something-strong

# ─── Data Storage ───────────────────────────────────
# On Railway, mount a volume at /data and set DATA_DIR=/data
# Locally the default is ./data
DATA_DIR=./data
CLIENTS_FILE=clients.json
